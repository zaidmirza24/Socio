# Supabase (Public - Client Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Server Only - Never Expose to Client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encrypts credentials saved from Settings. Any random 32+ character string. Set once, never change.
# (If omitted, the service-role key is used instead.)
SETTINGS_ENCRYPTION_KEY=generate-a-long-random-string-here

# Optional. Only needed to create the very first admin through the API
# (send it as the "x-bootstrap-token" header). Without it, create the first user in
# Supabase Auth -> Users instead; the first user automatically becomes admin.
# BOOTSTRAP_TOKEN=generate-a-long-random-string-here

# ---------------------------------------------------------------------------
# OPTIONAL: Apify values can now be pasted in Settings -> Apify Connection.
# Anything saved in Settings takes priority over these.
# ---------------------------------------------------------------------------
# APIFY_API_TOKEN=your-apify-api-token
# APIFY_TASK_ID=your-apify-task-id
